# Serviciu de utilizator (systemctl --user). Pornește la boot datorită „linger”
# (loginctl enable-linger), chiar dacă nu e nimeni logat. Rulând în sesiunea
# utilizatorului, are acces și la sunetul prin PipeWire de pe Raspberry Pi OS cu desktop.
[Unit]
Description=Demo lansare racheta (rocket_demo)
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/.venv/bin/python -m rocket_demo
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
